# Copiar a .env y completar. El archivo .env NUNCA se versiona.

# API key de Anthropic (https://console.anthropic.com) — requerida
ANTHROPIC_API_KEY=

# Modelo a usar — opcional (default: claude-sonnet-5)
#TUTOR_MODEL=claude-sonnet-5

# Carpeta de datos del estudiante (perfil, curso, progreso) — opcional (default: ./data)
#TUTOR_DATA_DIR=./data
