# Copiar a .env y completar. El archivo .env NUNCA se versiona.

# API key de OpenAI (https://platform.openai.com/api-keys) — requerida
OPENAI_API_KEY=

# Modelo a usar — opcional (default: gpt-5-mini)
#TUTOR_MODEL=gpt-5-mini

# Carpeta de datos del estudiante (perfil, curso, progreso) — opcional (default: ./data)
#TUTOR_DATA_DIR=./data
