# Copiar a .env y completar. El archivo .env NUNCA se versiona.

# API key de OpenAI (https://platform.openai.com/api-keys) — requerida con OpenAI
OPENAI_API_KEY=

# Modelo local gratis: endpoint compatible con OpenAI (p. ej. Ollama). Con esto
# la API key es opcional. Pon también TUTOR_MODEL (p. ej. gemma3:4b).
#TUTOR_BASE_URL=http://localhost:11434/v1

# Modelo a usar — opcional (default: gpt-5-mini)
#TUTOR_MODEL=gpt-5-mini

# Modelo del carril conversacional (turnos de estudio, charla, conversatorio).
# Opcional: vacío = usar TUTOR_MODEL para todo. Cambiarlo requiere reiniciar.
#TUTOR_MODEL_CHAT=gpt-5-nano

# Carpeta de datos del estudiante (perfil, curso, progreso) — opcional (default: ./data)
#TUTOR_DATA_DIR=./data

# Ilustraciones de las clases con IA (bonus, cuesta por imagen) — opcional
#TUTOR_IMAGENES=1
